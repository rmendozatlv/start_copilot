@inherits ErpComponents.Core.Components.Base.ErpComponentBase

<div @attributes="AdditionalAttributes" class="@GetContainerClasses()">
    <!-- Header con título y acciones -->
    @if (!string.IsNullOrEmpty(Title) || HeaderTemplate != null)
    {
        <div class="@GetHeaderClasses()">
            @if (HeaderTemplate == null)
            {
                <h2 class="@GetTitleClasses()">@Title</h2>
            }
            else
            {
                @HeaderTemplate
            }
            
            @if (ToolbarTemplate != null)
            {
                <div class="@GetToolbarClasses()">
                    @ToolbarTemplate
                </div>
            }
        </div>
    }
    
    <!-- Filtros -->
    @if (FilterTemplate != null)
    {
        <div class="@GetFilterClasses()">
            @FilterTemplate
        </div>
    }
    
    <!-- Tabla de datos -->
    <div class="overflow-x-auto">
        <table class="@GetTableClasses()">
            @if (ShowHeader)
            {
                <thead class="@GetTheadClasses()">
                    <tr>
                        @if (ShowRowSelection)
                        {
                            <th class="@GetThClasses() + \" w-10\"">
                                <input type="checkbox" 
                                       @onclick="ToggleSelectAll"
                                       checked="@IsAllSelected"
                                       class="@GetCheckboxClasses()" />
                            </th>
                        }
                        @foreach (var column in Columns)
                        {
                            <th class="@GetThClasses()" 
                                style="@GetColumnWidthStyle(column.Width)">
                                @if (column.Sortable)
                                {
                                    <button @onclick="() => HandleSort(column)" 
                                            class="@GetSortButtonClasses(column)">
                                        @column.Title
                                        @if (column.SortDirection != null)
                                        {
                                            <span class="ml-1 inline-block">
                                                @if (column.SortDirection == SortDirection.Ascending)
                                                {
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                                    </svg>
                                                }
                                            </span>
                                        }
                                    </button>
                                }
                                else
                                {
                                    @column.Title
                                }
                            </th>
                        }
                        @if (ActionsTemplate != null)
                        {
                            <th class="@GetThClasses() + \" text-right\"">Acciones</th>
                        }
                    </tr>
                </thead>
            }
            
            <tbody class="@GetTbodyClasses()">
                @if (Loading)
                {
                    <tr>
                        <td colspan="@GetColspanValue()" class="@GetLoadingCellClasses()">
                            <div class="flex justify-center items-center py-8">
                                <div class="animate-spin rounded-full h-8 w-8 border-b-2" 
                                     style="border-color: @CurrentTheme.PrimaryColors.Default"></div>
                                <span class="ml-3">Cargando...</span>
                            </div>
                        </td>
                    </tr>
                }
                else if (Data == null || !Data.Any())
                {
                    <tr>
                        <td colspan="@GetColspanValue()" class="@GetEmptyCellClasses()">
                            @if (EmptyTemplate != null)
                            {
                                @EmptyTemplate
                            }
                            else
                            {
                                <div class="text-center py-8">
                                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                                    </svg>
                                    <p class="mt-2 text-sm text-gray-600">No hay datos disponibles</p>
                                </div>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Data.Select((value, index) => new { Value = value, Index = index }))
                    {
                        <tr class="@GetRowClasses(item.Index)" 
                            @onclick="() => HandleRowClick(item.Value)">
                            @if (ShowRowSelection)
                            {
                                <td class="@GetTdClasses()">
                                    <input type="checkbox" 
                                           checked="@SelectedItems.Contains(item.Value)"
                                           @onclick="() => ToggleItemSelection(item.Value)"
                                           class="@GetCheckboxClasses()" />
                                </td>
                            }
                            @foreach (var column in Columns)
                            {
                                <td class="@GetTdClasses()">
                                    @if (column.CellTemplate != null)
                                    {
                                        @column.CellTemplate(item.Value)
                                    }
                                    else
                                    {
                                        @column.GetValue(item.Value)
                                    }
                                </td>
                            }
                            @if (ActionsTemplate != null)
                            {
                                <td class="@GetTdClasses() + \" text-right\"">
                                    @ActionsTemplate(item.Value)
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
            
            @if (ShowFooter && FooterTemplate != null)
            {
                <tfoot class="@GetTfootClasses()">
                    @FooterTemplate
                </tfoot>
            }
        </table>
    </div>
    
    <!-- Paginación -->
    @if (ShowPagination && TotalItems > 0)
    {
        <div class="@GetPaginationContainerClasses()">
            @if (PaginationTemplate == null)
            {
                <div class="flex items-center justify-between">
                    <div class="text-sm @GetTextMutedClasses()">
                        Mostrando <span class="font-medium">@((CurrentPage - 1) * PageSize + 1)</span> a 
                        <span class="font-medium">@Math.Min(CurrentPage * PageSize, TotalItems)</span> de 
                        <span class="font-medium">@TotalItems</span> resultados
                    </div>
                    <div class="flex space-x-2">
                        <ErpButton Variant="outline" Size="sm" Disabled="@(CurrentPage == 1)" OnClick="PreviousPage">
                            Anterior
                        </ErpButton>
                        
                        @for (int i = StartPage; i <= EndPage; i++)
                        {
                            <ErpButton Variant="@(i == CurrentPage ? "primary" : "outline")" Size="sm" OnClick="() => GoToPage(i)">
                                @i
                            </ErpButton>
                        }
                        
                        <ErpButton Variant="outline" Size="sm" Disabled="@(CurrentPage == TotalPages)" OnClick="NextPage">
                            Siguiente
                        </ErpButton>
                    </div>
                </div>
            }
            else
            {
                @PaginationTemplate
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// Datos a mostrar en la tabla
    /// </summary>
    [Parameter]
    public IEnumerable<object>? Data { get; set; }
    
    /// <summary>
    /// Columnas de la tabla
    /// </summary>
    [Parameter]
    public IEnumerable<DataGridColumn>? Columns { get; set; } = Enumerable.Empty<DataGridColumn>();
    
    /// <summary>
    /// Título de la tabla
    /// </summary>
    [Parameter]
    public string? Title { get; set; }
    
    /// <summary>
    /// Plantilla personalizada para el encabezado
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }
    
    /// <summary>
    /// Plantilla para la barra de herramientas
    /// </summary>
    [Parameter]
    public RenderFragment? ToolbarTemplate { get; set; }
    
    /// <summary>
    /// Plantilla para filtros
    /// </summary>
    [Parameter]
    public RenderFragment? FilterTemplate { get; set; }
    
    /// <summary>
    /// Plantilla para celdas de acción
    /// </summary>
    [Parameter]
    public RenderFragment<object>? ActionsTemplate { get; set; }
    
    /// <summary>
    /// Plantilla para contenido vacío
    /// </summary>
    [Parameter]
    public RenderFragment? EmptyTemplate { get; set; }
    
    /// <summary>
    /// Plantilla para pie de tabla
    /// </summary>
    [Parameter]
    public RenderFragment? FooterTemplate { get; set; }
    
    /// <summary>
    /// Plantilla personalizada para paginación
    /// </summary>
    [Parameter]
    public RenderFragment? PaginationTemplate { get; set; }
    
    /// <summary>
    /// Indica si mostrar el header de la tabla
    /// </summary>
    [Parameter]
    public bool ShowHeader { get; set; } = true;
    
    /// <summary>
    /// Indica si mostrar selección de filas
    /// </summary>
    [Parameter]
    public bool ShowRowSelection { get; set; }
    
    /// <summary>
    /// Indica si mostrar paginación
    /// </summary>
    [Parameter]
    public bool ShowPagination { get; set; } = true;
    
    /// <summary>
    /// Indica si mostrar pie de tabla
    /// </summary>
    [Parameter]
    public bool ShowFooter { get; set; }
    
    /// <summary>
    /// Indica si está cargando datos
    /// </summary>
    [Parameter]
    public bool Loading { get; set; }
    
    /// <summary>
    /// Número total de elementos
    /// </summary>
    [Parameter]
    public int TotalItems { get; set; }
    
    /// <summary>
    /// Página actual
    /// </summary>
    [Parameter]
    public int CurrentPage { get; set; } = 1;
    
    /// <summary>
    /// Elementos por página
    /// </summary>
    [Parameter]
    public int PageSize { get; set; } = 10;
    
    /// <summary>
    /// Evento cuando cambia la página
    /// </summary>
    [Parameter]
    public EventCallback<int> PageChanged { get; set; }
    
    /// <summary>
    /// Evento cuando cambia el ordenamiento
    /// </summary>
    [Parameter]
    public EventCallback<DataGridColumn> SortChanged { get; set; }
    
    /// <summary>
    /// Evento cuando se hace click en una fila
    /// </summary>
    [Parameter]
    public EventCallback<object> RowClicked { get; set; }
    
    /// <summary>
    /// Elementos seleccionados
    /// </summary>
    [Parameter]
    public IEnumerable<object>? SelectedItems { get; set; }
    
    /// <summary>
    /// Evento cuando cambia la selección
    /// </summary>
    [Parameter]
    public EventCallback<IEnumerable<object>> SelectedItemsChanged { get; set; }
    
    private List<object> _selectedItems = new();
    
    /// <summary>
    /// Obtiene las clases del contenedor principal
    /// </summary>
    private string GetContainerClasses()
    {
        var theme = CurrentTheme;
        return BuildClass(
            "w-full",
            $"bg-[{theme.NeutralColors.White}]",
            "rounded-lg",
            "shadow"
        );
    }
    
    private string GetHeaderClasses() => BuildClass("px-6", "py-4", "border-b", "flex", "items-center", "justify-between");
    private string GetTitleClasses() => BuildClass("text-lg", "font-semibold");
    private string GetToolbarClasses() => BuildClass("flex", "space-x-2");
    private string GetFilterClasses() => BuildClass("px-6", "py-3", "border-b", "bg-gray-50");
    
    private string GetTableClasses() => BuildClass("min-w-full", "divide-y", "divide-gray-200");
    private string GetTheadClasses() => BuildClass($"bg-[{CurrentTheme.NeutralColors.Gray50}]");
    private string GetTbodyClasses() => BuildClass($"bg-[{CurrentTheme.NeutralColors.White}]", "divide-y", "divide-gray-200");
    private string GetTfootClasses() => BuildClass($"bg-[{CurrentTheme.NeutralColors.Gray50}]", "border-t");
    
    private string GetThClasses() => BuildClass("px-6", "py-3", "text-left", "text-xs", "font-medium", "uppercase", "tracking-wider");
    private string GetTdClasses() => BuildClass("px-6", "py-4", "whitespace-nowrap");
    
    private string GetRowClasses(int index)
    {
        var theme = CurrentTheme;
        var classes = new List<string>
        {
            "hover:" + $"bg-[{theme.NeutralColors.Gray50}]",
            "transition-colors",
            "cursor-pointer"
        };
        
        if (index % 2 == 1)
        {
            classes.Add($"bg-[{theme.NeutralColors.Gray50}]");
        }
        
        return BuildClass(classes.ToArray());
    }
    
    private string GetLoadingCellClasses() => BuildClass("px-6", "py-8");
    private string GetEmptyCellClasses() => BuildClass("px-6", "py-8");
    private string GetPaginationContainerClasses() => BuildClass("px-6", "py-4", "border-t");
    private string GetTextMutedClasses() => BuildClass("text-gray-600");
    private string GetCheckboxClasses() => BuildClass("rounded", "border-gray-300");
    
    private string GetSortButtonClasses(DataGridColumn column)
    {
        var classes = new List<string>("flex", "items-center", "font-medium");
        if (column.SortDirection != null)
        {
            classes.Add($"text-[{CurrentTheme.PrimaryColors.Default}]");
        }
        return BuildClass(classes.ToArray());
    }
    
    private bool IsAllSelected => Data != null && Data.All(item => _selectedItems.Contains(item));
    private int TotalPages => (int)Math.Ceiling((double)TotalItems / PageSize);
    private int StartPage => Math.Max(1, CurrentPage - 2);
    private int EndPage => Math.Min(TotalPages, CurrentPage + 2);
    
    private string GetColumnWidthStyle(string? width)
    {
        return string.IsNullOrEmpty(width) ? "" : $"width: {width};";
    }
    
    private int GetColspanValue()
    {
        var count = Columns?.Count() ?? 0;
        if (ShowRowSelection) count++;
        if (ActionsTemplate != null) count++;
        return count;
    }
    
    private async Task ToggleSelectAll()
    {
        if (Data != null)
        {
            if (IsAllSelected)
            {
                _selectedItems.Clear();
            }
            else
            {
                _selectedItems = Data.ToList();
            }
            
            if (SelectedItemsChanged.HasDelegate)
            {
                await SelectedItemsChanged.InvokeAsync(_selectedItems);
            }
        }
    }
    
    private async Task ToggleItemSelection(object item)
    {
        if (_selectedItems.Contains(item))
        {
            _selectedItems.Remove(item);
        }
        else
        {
            _selectedItems.Add(item);
        }
        
        if (SelectedItemsChanged.HasDelegate)
        {
            await SelectedItemsChanged.InvokeAsync(_selectedItems);
        }
    }
    
    private async Task HandleSort(DataGridColumn column)
    {
        column.SortDirection = column.SortDirection switch
        {
            null => SortDirection.Ascending,
            SortDirection.Ascending => SortDirection.Descending,
            SortDirection.Descending => null
        };
        
        // Reset other columns
        foreach (var col in Columns ?? Enumerable.Empty<DataGridColumn>())
        {
            if (col != column)
            {
                col.SortDirection = null;
            }
        }
        
        if (SortChanged.HasDelegate)
        {
            await SortChanged.InvokeAsync(column);
        }
    }
    
    private async Task HandleRowClick(object item)
    {
        if (RowClicked.HasDelegate)
        {
            await RowClicked.InvokeAsync(item);
        }
    }
    
    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            if (PageChanged.HasDelegate)
            {
                await PageChanged.InvokeAsync(CurrentPage);
            }
        }
    }
    
    private async Task NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            if (PageChanged.HasDelegate)
            {
                await PageChanged.InvokeAsync(CurrentPage);
            }
        }
    }
    
    private async Task GoToPage(int page)
    {
        CurrentPage = page;
        if (PageChanged.HasDelegate)
        {
            await PageChanged.InvokeAsync(CurrentPage);
        }
    }
}

/// <summary>
/// Define una columna de la tabla de datos
/// </summary>
public class DataGridColumn
{
    public string Title { get; set; } = "";
    public string Field { get; set; } = "";
    public string? Width { get; set; }
    public bool Sortable { get; set; }
    public SortDirection? SortDirection { get; set; }
    public RenderFragment<object>? CellTemplate { get; set; }
    
    public string GetValue(object item)
    {
        var property = item.GetType().GetProperty(Field);
        return property?.GetValue(item)?.ToString() ?? "";
    }
}

/// <summary>
/// Dirección de ordenamiento
/// </summary>
public enum SortDirection
{
    Ascending,
    Descending
}
